# Root .htaccess - Laravel "flat" sur IONOS pour /P2026/ABOODI/
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /P2026/ABOODI

    # Authorization & XSRF Headers
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Sert les assets statiques depuis public/ (Css, Js, img, build, storage, favicon, robots)
    RewriteRule ^(Css|css|Js|js|img|build|storage)/(.*)$ public/$1/$2 [L]
    RewriteRule ^favicon\.ico$ public/favicon.ico [L]
    RewriteRule ^robots\.txt$ public/robots.txt [L]

    # Bloque les dossiers Laravel sensibles
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|lang|vendor|node_modules)(/|$) - [F,L]
    RewriteRule ^\.git(/|$) - [F,L]
    RewriteRule ^\.idea(/|$) - [F,L]

    # Bloque les fichiers sensibles par nom
    RewriteRule ^(\.env|\.env\..*|\.htaccess|\.gitignore|\.gitattributes|\.editorconfig)$ - [F,L]
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|README\.md)$ - [F,L]
    RewriteRule ^(postcss|tailwind|vite)\.config\.js$ - [F,L]

    # Redirect Trailing Slashes If Not A Folder
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller (root index.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

<FilesMatch "^(\.env|\.env\..*|\.htaccess|\.gitignore|\.gitattributes|\.editorconfig|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|postcss\.config\.js|tailwind\.config\.js|vite\.config\.js|README\.md)$">
    Require all denied
</FilesMatch>
